# OpenRouter API Key (Required for RAG responses)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (Optional, defaults to mistralai/mistral-small-24b-instruct-2501 or similar)
OPENROUTER_MODEL=mistralai/mistral-small-24b-instruct-2501

# Embedding Model (Optional, defaults to sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gnani API Key (Optional, for Gnani STT/TTS voice)
GNANI_API_KEY=your_gnani_api_key_here
